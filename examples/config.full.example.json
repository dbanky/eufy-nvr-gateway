{
  "timezone": "Europe/London",

  "eufy": { "country": "GB" },

  "web": { "username": "admin", "password": "choose-a-password", "theme": "auto", "https": false },

  "rtsp": { "username": "protect", "password": "choose-another-password" },

  "checkForUpdates": true,

  "ports": {
    "web": 8099,
    "rtsp": 8554
  },

  "defaults": {
    "fps": 15,
    "holdMs": 30000,
    "motionInPicture": true,
    "motionInPictureMaxMs": 300000,
    "ringHoldMs": 120000,
    "restartGapMs": 15000,
    "minBatteryPct": 15,
    "transcode": false,
    "audio": false,
    "triggers": ["motion", "personDetected", "vehicleDetected", "petDetection", "strangerDetected", "doorbellPress"]
  },

  "cameras": [
    {
      "name": "front-door",
      "serial": "T81XXXXXXXXXXXXX",
      "width": 2048,
      "height": 1536,
      "bitrateKbps": 4400,
      "udpPort": 40000
    },
    {
      "name": "garden",
      "serial": "T81XXXXXXXXXXXXX",
      "width": 2880,
      "height": 1616,
      "bitrateKbps": 6600,
      "udpPort": 40004,
      "onvif": { "address": "192.168.1.51", "port": 8000, "mac": "02:00:00:00:00:01" }
    }
  ],

  "bridge": {
    "env": { "BRIDGE_EVENT_LOG": "1" }
  }
}
