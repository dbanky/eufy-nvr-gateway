{
  "timezone": "Europe/London",

  "eufy": { "country": "GB" },

  "ports": {
    "web": 8099,
    "rtsp": 8554
  },

  "defaults": {
    "fps": 15,
    "holdMs": 120000,
    "ringHoldMs": 120000,
    "restartGapMs": 15000,
    "minBatteryPct": 15,
    "triggers": ["motion", "personDetected", "vehicleDetected", "petDetection", "strangerDetected", "doorbellPress"]
  },

  "cameras": [
    {
      "name": "front-door",
      "serial": "T81XXXXXXXXXXXXX",
      "width": 2048,
      "height": 1536,
      "bitrateKbps": 4000
    },
    {
      "name": "garden",
      "serial": "T81XXXXXXXXXXXXX",
      "width": 2880,
      "height": 1616,
      "bitrateKbps": 6000
    }
  ],

  "bridge": {
    "env": { "BRIDGE_EVENT_LOG": "1" }
  }
}
